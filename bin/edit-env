#!/bin/bash

set -o pipefail
umask 077

BAO_ENV_MOUNT="${BAO_ENV_MOUNT:-kv}"
BAO_ENV_PREFIX="${BAO_ENV_PREFIX:-env}"
BAO_OIDC_PATH="${BAO_OIDC_PATH:-oidc}"
BAO_OIDC_ROLE="${BAO_OIDC_ROLE:-admin}"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

TEMP_DIR=""
DATA_FILE=""
RESPONSE_FILE=""
VALUE_FILE=""
BAO_ERROR_FILE=""

cleanup() {
    [ -z "$TEMP_DIR" ] || rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

bao_with_auth() {
    : > "$BAO_ERROR_FILE"
    if command bao "$@" 2>"$BAO_ERROR_FILE"; then
        [ ! -s "$BAO_ERROR_FILE" ] || cat "$BAO_ERROR_FILE" >&2
        return 0
    fi

    if ! grep -Eqi 'permission denied|missing client token|no token|code:[[:space:]]*403' "$BAO_ERROR_FILE"; then
        cat "$BAO_ERROR_FILE" >&2
        return 1
    fi

    : > "$BAO_ERROR_FILE"
    if env -u VAULT_TOKEN -u BAO_TOKEN bao "$@" 2>"$BAO_ERROR_FILE"; then
        [ ! -s "$BAO_ERROR_FILE" ] || cat "$BAO_ERROR_FILE" >&2
        return 0
    fi

    if ! grep -Eqi 'permission denied|missing client token|no token|code:[[:space:]]*403' "$BAO_ERROR_FILE"; then
        cat "$BAO_ERROR_FILE" >&2
        return 1
    fi

    if ! env -u VAULT_TOKEN -u BAO_TOKEN bao login -no-print -method=oidc -path="$BAO_OIDC_PATH" role="$BAO_OIDC_ROLE" >&2; then
        return 1
    fi

    env -u VAULT_TOKEN -u BAO_TOKEN bao "$@"
}

get_env_groups() {
    bao_with_auth kv list -format=json -mount="$BAO_ENV_MOUNT" "$BAO_ENV_PREFIX" |
        jq -r 'if type == "array" then .[] else .data.keys[] end | rtrimstr("/")' |
        sort
}

validate_group_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

load_group() {
    local group_name="$1"
    local version

    bao_with_auth kv get -format=json -mount="$BAO_ENV_MOUNT" "$BAO_ENV_PREFIX/$group_name" > "$RESPONSE_FILE" || return 1
    if ! jq -e '.data.data | type == "object" and all(keys[]; test("^[A-Za-z_][A-Za-z0-9_]*$")) and all(.[]; type == "string" and (test("[\\r\\n]") | not))' "$RESPONSE_FILE" >/dev/null; then
        echo -e "${RED}Environment group '$group_name' contains invalid data.${NC}" >&2
        return 1
    fi

    version=$(jq -r '.data.metadata.version' "$RESPONSE_FILE") || return 1
    jq '.data.data' "$RESPONSE_FILE" > "$DATA_FILE" || return 1
    : > "$RESPONSE_FILE"
    printf '%s\n' "$version"
}

main() {
    local existing_groups
    local options
    local choice
    local action
    local group_name
    local cas_version
    local var_name

    if ! command -v bao >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1 || ! command -v gum >/dev/null 2>&1; then
        echo -e "${RED}Error: bao, jq, and gum are required.${NC}" >&2
        exit 1
    fi

    TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/edit-env.XXXXXX") || exit 1
    chmod 700 "$TEMP_DIR"
    DATA_FILE="$TEMP_DIR/data.json"
    RESPONSE_FILE="$TEMP_DIR/response.json"
    VALUE_FILE="$TEMP_DIR/value"
    BAO_ERROR_FILE="$TEMP_DIR/bao-error"
    : > "$DATA_FILE"
    : > "$RESPONSE_FILE"
    : > "$VALUE_FILE"
    : > "$BAO_ERROR_FILE"
    chmod 600 "$DATA_FILE" "$RESPONSE_FILE" "$VALUE_FILE" "$BAO_ERROR_FILE"

    echo -e "${GREEN}Environment Variable Manager${NC}"
    echo "=============================="

    existing_groups=$(get_env_groups) || exit 1
    if [ -z "$existing_groups" ]; then
        action=create
        echo -e "${YELLOW}No existing environment groups found.${NC}"
    else
        options="Create new group"
        while IFS= read -r group; do
            options="$options\n$group"
        done <<< "$existing_groups"

        choice=$(echo -e "$options" | gum choose --header "Select environment group to edit or create new:")
        if [ "$choice" = "Create new group" ]; then
            action=create
        elif [ -n "$choice" ]; then
            action=edit
            group_name="$choice"
        else
            exit 1
        fi
    fi

    if [ "$action" = create ]; then
        group_name=$(gum input --prompt "Enter new group name (e.g., aws, openai): " --placeholder "my-secrets")
        if ! validate_group_name "$group_name"; then
            echo -e "${RED}Group names may contain only letters, numbers, dots, underscores, and hyphens.${NC}"
            exit 1
        fi
        printf '{}\n' > "$DATA_FILE"
        cas_version=0
    else
        cas_version=$(load_group "$group_name") || exit 1
        echo -e "\n${YELLOW}Existing variables in ${group_name}:${NC}"
        jq -r 'keys[] | "\(.)=***"' "$DATA_FILE" | gum format
    fi

    while true; do
        echo -e "\n${GREEN}Adding/updating environment variable${NC}"
        var_name=$(gum input --prompt "Enter variable name: " --placeholder "API_KEY")
        if [[ ! "$var_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            echo -e "${RED}Variable names must be valid shell identifiers.${NC}"
            continue
        fi

        if jq -e --arg name "$var_name" 'has($name)' "$DATA_FILE" >/dev/null; then
            echo -e "${YELLOW}Variable already exists. Current value will be replaced.${NC}"
        fi

        gum input --prompt "Enter value: " --placeholder "Enter value" --password > "$VALUE_FILE"
        if ! jq -e -Rs 'rtrimstr("\n") | length > 0' "$VALUE_FILE" >/dev/null; then
            echo -e "${RED}Variable value cannot be empty.${NC}"
            continue
        fi

        jq --arg name "$var_name" --rawfile value "$VALUE_FILE" '.[$name] = ($value | rtrimstr("\n"))' "$DATA_FILE" > "$DATA_FILE.next" || exit 1
        : > "$VALUE_FILE"
        mv "$DATA_FILE.next" "$DATA_FILE"
        chmod 600 "$DATA_FILE"
        echo -e "${GREEN}Added/updated: ${NC}${var_name}"

        if ! gum confirm "Add another variable?"; then
            break
        fi
    done

    echo -e "\n${YELLOW}Saving environment group to OpenBao...${NC}"
    bao_with_auth kv put -format=json -mount="$BAO_ENV_MOUNT" -cas="$cas_version" "$BAO_ENV_PREFIX/$group_name" "@$DATA_FILE" >/dev/null || exit 1
    echo -e "${GREEN}Environment group '${group_name}' has been saved.${NC}"
}

main
