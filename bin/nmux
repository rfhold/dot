#!/bin/bash

# nmux - Fuzzy search repos and open in tmux
# Usage: nmux [--create] [--worktree [name]] [category/repo-name]
#   nmux                               - Interactive mode with fuzzy search
#   nmux stablekernel/github-token-bot - Direct mode with specific repo
#   nmux --create rfhold/new-repo      - Create remote repo if missing, then open
#   nmux --worktree rfhold/dot         - Pick a worktree
#   nmux --worktree feature rfhold/dot - Open an existing named worktree

# Configuration
REPOS_DIR="$HOME/repos"

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to check if directory exists
check_repos_dir() {
    if [ ! -d "$REPOS_DIR" ]; then
        echo -e "${RED}Error: Repos directory '$REPOS_DIR' not found.${NC}" >&2
        exit 1
    fi
}

# Function to get list of repos
get_repos() {
    find "$REPOS_DIR" -mindepth 2 -maxdepth 2 -type d 2>/dev/null | \
        sed "s|$REPOS_DIR/||" | sort
}

# Function to check if tmux session exists
session_exists() {
    local session_name="$1"
    tmux has-session -t "$session_name" 2>/dev/null
}

# Function to create or get session
ensure_session() {
    local category="$1"
    local session_name="$category"
    
    if ! session_exists "$session_name"; then
        echo -e "${BLUE}Creating new tmux session: $session_name${NC}" >&2
        # Create session with a single default window in the category directory
        tmux new-session -d -s "$session_name" -c "$REPOS_DIR/$category"
        # Wait a moment for session to be fully created
        sleep 0.1
    else
        echo -e "${GREEN}Using existing tmux session: $session_name${NC}" >&2
    fi
    
    echo "$session_name"
}

# Function to ensure repo exists (delegates to gmux)
ensure_repo() {
    local repo_path="$1"
    local create="$2"
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    local gmux_args=()
    [ "$create" = "1" ] && gmux_args+=("--create")
    gmux_args+=("$repo_path")

    if ! "$script_dir/gmux" "${gmux_args[@]}"; then
        echo -e "${YELLOW}Available repositories:${NC}" >&2
        get_repos | sed 's/^/  /' >&2
        exit 1
    fi
}

open_worktree() {
    local repo_path="$1" name="$2" selected="" path="" branch="" entry="" choice=""
    local -a paths=() labels=()
    while IFS= read -r entry; do
        case "$entry" in
            'worktree '*) path="${entry#worktree }"; branch="" ;;
            'branch '*) branch="${entry#branch refs/heads/}" ;;
            '')
                if [ -n "$path" ] && [ "$path" != "$repo_path" ] && [ -d "$path" ]; then
                    paths+=("$path")
                    labels+=("$(basename "$path") ($branch)")
                fi
                path=""
                ;;
        esac
    done < <(git -C "$repo_path" worktree list --porcelain; printf '\n')

    if [ -n "$name" ]; then
        local i
        for i in "${!paths[@]}"; do
            if [ "$(basename "${paths[i]}")" = "$name" ] || [ "$repo_path/.worktrees/$name" = "${paths[i]}" ]; then
                selected="${paths[i]}"
                break
            fi
        done
        if [ -z "$selected" ]; then
            echo -e "${RED}Worktree '$name' not found.${NC}" >&2
            return 1
        fi
    else
        choice=$(printf '%s\n' "Main checkout" "${labels[@]}" "+ Create worktree" | gum filter --prompt 'worktree >' --placeholder '')
        case "$choice" in
            'Main checkout') selected="$repo_path" ;;
            '+ Create worktree')
                name=$(gum input --prompt 'Worktree name > ' --placeholder 'feature-name')
                if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || [ "$name" = . ] || [ "$name" = .. ]; then
                    echo -e "${RED}Invalid worktree name.${NC}" >&2
                    return 1
                fi
                selected="$repo_path/.worktrees/$name"
                if [ -e "$selected" ]; then
                    echo -e "${RED}Path already exists: $selected${NC}" >&2
                    return 1
                fi
                local base
                base=$(git -C "$repo_path" symbolic-ref --short HEAD) || return 1
                local exclude
                exclude=$(git -C "$repo_path" rev-parse --path-format=absolute --git-path info/exclude) || return 1
                if ! grep -Fxq '/.worktrees/' "$exclude" 2>/dev/null; then
                    printf '\n/.worktrees/\n' >> "$exclude" || return 1
                fi
                mkdir -p "$repo_path/.worktrees" || return 1
                git -C "$repo_path" worktree add -b "$name" "$selected" "$base" || return 1
                ;;
            '') return 1 ;;
            *)
                local i
                for i in "${!labels[@]}"; do
                    if [ "$choice" = "${labels[i]}" ]; then
                        selected="${paths[i]}"
                        break
                    fi
                done
                [ -n "$selected" ] || return 1
                ;;
        esac
    fi
    WORKTREE_PATH="$selected"
}

# Main function
main() {
    check_repos_dir

    local create=0
    local repo_arg worktree=0 worktree_name=""

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --create) create=1; shift ;;
            --worktree)
                worktree=1; shift
                if [ $# -ge 2 ] && [[ "$1" != --* ]]; then
                    worktree_name="$1"; shift
                fi
                ;;
            *) repo_arg="$1"; shift ;;
        esac
    done

    local selected_repo

    # Check if repo was provided as argument
    if [ -n "$repo_arg" ]; then
        # Direct mode - use provided repo path
        selected_repo="$repo_arg"
        ensure_repo "$selected_repo" "$create"
        echo -e "${BLUE}Direct mode: Using repository '$selected_repo'${NC}" >&2
    else
        # Interactive mode - use gum to select
        # Get list of available repos
        repos=$(get_repos)
        
        if [ -z "$repos" ]; then
            echo -e "${RED}No repositories found in $REPOS_DIR${NC}" >&2
            echo "Expected structure: $REPOS_DIR/category/repo-name" >&2
            exit 1
        fi
        
        # Let user choose a repo with fuzzy search
        selected_repo=$(echo "$repos" | gum filter --prompt 'repo name >' --placeholder '')
        
        if [ -z "$selected_repo" ]; then
            echo -e "${RED}No repository selected.${NC}" >&2
            exit 1
        fi
    fi
    
    # Parse category and repo name
    category=$(echo "$selected_repo" | cut -d'/' -f1)
    repo_name=$(echo "$selected_repo" | cut -d'/' -f2)
    repo_path="$REPOS_DIR/$selected_repo"

    local window_name="$repo_name"
    if [ "$worktree" -eq 1 ] || [ -z "$repo_arg" ]; then
        open_worktree "$repo_path" "$worktree_name" || exit 1
        if [ "$WORKTREE_PATH" != "$repo_path" ]; then
            repo_path="$WORKTREE_PATH"
            window_name="$repo_name|$(basename "$repo_path")"
        fi
    fi
    
    echo -e "${YELLOW}Selected: $selected_repo${NC}" >&2
    echo -e "${YELLOW}Category: $category${NC}" >&2
    echo -e "${YELLOW}Repository: $repo_name${NC}" >&2
    
    # Ensure session exists for the category
    session_name=$(ensure_session "$category")
    
    # Use tmux-window script to create/switch to window
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    
    if [ ! -x "$script_dir/tmux-window" ]; then
        echo -e "${RED}Error: tmux-window script not found or not executable${NC}" >&2
        echo -e "${YELLOW}Expected at: $script_dir/tmux-window${NC}" >&2
        exit 1
    fi
    
    "$script_dir/tmux-window" "$session_name" "$window_name" "$repo_path"
}

# Run main function
main "$@"
