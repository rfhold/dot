#!/bin/bash

set -o pipefail
umask 077

BAO_ENV_MOUNT="${BAO_ENV_MOUNT:-kv}"
BAO_ENV_PREFIX="${BAO_ENV_PREFIX:-env}"
BAO_OIDC_PATH="${BAO_OIDC_PATH:-oidc}"
BAO_OIDC_ROLE="${BAO_OIDC_ROLE:-admin}"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

BAO_ERROR_FILE=""

cleanup() {
    [ -z "$BAO_ERROR_FILE" ] || rm -f "$BAO_ERROR_FILE"
}
trap cleanup EXIT

bao_with_auth() {
    if [ -z "$BAO_ERROR_FILE" ]; then
        BAO_ERROR_FILE=$(mktemp "${TMPDIR:-/tmp}/env-select.XXXXXX") || return 1
        chmod 600 "$BAO_ERROR_FILE"
    fi

    : > "$BAO_ERROR_FILE"
    if command bao "$@" 2>"$BAO_ERROR_FILE"; then
        [ ! -s "$BAO_ERROR_FILE" ] || cat "$BAO_ERROR_FILE" >&2
        return 0
    fi

    if ! grep -Eqi 'permission denied|missing client token|no token|code:[[:space:]]*403' "$BAO_ERROR_FILE"; then
        cat "$BAO_ERROR_FILE" >&2
        return 1
    fi

    : > "$BAO_ERROR_FILE"
    if env -u VAULT_TOKEN -u BAO_TOKEN bao "$@" 2>"$BAO_ERROR_FILE"; then
        [ ! -s "$BAO_ERROR_FILE" ] || cat "$BAO_ERROR_FILE" >&2
        return 0
    fi

    if ! grep -Eqi 'permission denied|missing client token|no token|code:[[:space:]]*403' "$BAO_ERROR_FILE"; then
        cat "$BAO_ERROR_FILE" >&2
        return 1
    fi

    if [ "${BAO_ENV_NO_LOGIN:-false}" = true ]; then
        cat "$BAO_ERROR_FILE" >&2
        return 1
    fi

    if ! env -u VAULT_TOKEN -u BAO_TOKEN bao login -no-print -method=oidc -path="$BAO_OIDC_PATH" role="$BAO_OIDC_ROLE" >&2; then
        return 1
    fi

    env -u VAULT_TOKEN -u BAO_TOKEN bao "$@"
}

get_env_groups() {
    bao_with_auth kv list -format=json -mount="$BAO_ENV_MOUNT" "$BAO_ENV_PREFIX" |
        jq -r 'if type == "array" then .[] else .data.keys[] end | rtrimstr("/")' |
        sort
}

validate_group_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

get_secret_json() {
    local group_name="$1"
    local secret_json

    if ! validate_group_name "$group_name"; then
        echo "Error: Invalid environment group name '$group_name'." >&2
        return 1
    fi

    if ! secret_json=$(bao_with_auth kv get -format=json -mount="$BAO_ENV_MOUNT" "$BAO_ENV_PREFIX/$group_name"); then
        echo "Error: Environment group '$group_name' not found or could not be read." >&2
        return 1
    fi

    if ! jq -e '.data.data | type == "object" and all(keys[]; test("^[A-Za-z_][A-Za-z0-9_]*$")) and all(.[]; type == "string" and (test("[\\r\\n]") | not))' >/dev/null <<< "$secret_json"; then
        echo "Error: Environment group '$group_name' contains invalid data." >&2
        return 1
    fi

    printf '%s\n' "$secret_json"
}

output_group() {
    local group_name="$1"
    local format="$2"
    local secret_json

    secret_json=$(get_secret_json "$group_name") || return 1

    case "$format" in
        fish)
            jq -r --arg home "$HOME" '.data.data | to_entries | sort_by(.key)[] | "set -gx \(.key) \((.value | gsub("\\$HOME"; $home)) | @sh)"' <<< "$secret_json"
            ;;
        list)
            echo -e "${GREEN}Environment variables in group '${group_name}':${NC}" >&2
            jq -r '.data.data | keys[]' <<< "$secret_json" | while IFS= read -r key; do
                echo -e "${YELLOW}${key}${NC}=***" >&2
            done
            ;;
        raw)
            jq -r '.data.data | to_entries | sort_by(.key)[] | "\(.key)=\(.value)"' <<< "$secret_json"
            ;;
    esac
}

main() {
    local existing_groups
    local group_name
    local action
    local output_file

    if ! command -v bao >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
        echo -e "${RED}Error: bao and jq are required.${NC}" >&2
        exit 1
    fi

    BAO_ERROR_FILE=$(mktemp "${TMPDIR:-/tmp}/env-select.XXXXXX") || exit 1
    chmod 600 "$BAO_ERROR_FILE"

    if [ "$1" = "--groups" ]; then
        get_env_groups
        exit $?
    fi

    existing_groups=$(get_env_groups) || exit 1
    if [ -z "$existing_groups" ]; then
        echo -e "${RED}No environment groups found.${NC}" >&2
        exit 1
    fi

    if [ "$1" = "--fish-output" ] && [ -n "$2" ]; then
        output_group "$2" fish
    elif [ "$1" = "--list" ] && [ -n "$2" ]; then
        output_group "$2" list
    else
        echo -e "${GREEN}Environment Variable Loader${NC}" >&2
        echo "===========================" >&2

        group_name=$(printf '%s\n' "$existing_groups" | gum choose --header "Select environment group to load:")
        if [ -z "$group_name" ]; then
            echo -e "${RED}No group selected.${NC}" >&2
            exit 1
        fi

        action=$(printf 'Load into session\nShow variables\nExport to file\n' | gum choose --header "What would you like to do?")
        case "$action" in
            "Load into session")
                printf '%s\n' "$group_name"
                ;;
            "Show variables")
                output_group "$group_name" list
                ;;
            "Export to file")
                output_file=$(gum input --prompt "Enter output filename: " --placeholder "export.env")
                if [ -n "$output_file" ]; then
                    output_group "$group_name" raw > "$output_file" || exit 1
                    echo -e "${GREEN}Exported to: ${output_file}${NC}" >&2
                fi
                ;;
        esac
    fi
}

main "$@"
