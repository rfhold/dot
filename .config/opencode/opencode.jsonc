{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "@playwright/mcp@latest",
          "--isolated",
          "--browser",
          "chromium"
        ],
        "disabled": true
      }
    }
  },
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/Library/pnpm/store/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/pnpm/store/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.bun/install/cache/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.npm/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/go/pkg/mod/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Library/Caches/go-build/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/go-build/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cargo/registry/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cargo/git/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Library/Caches/pip/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/pip/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/uv/**", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "pkexe *", "effect": "ask" },
    { "action": "shell", "resource": "kill *", "effect": "ask" },
    { "action": "shell", "resource": "pkill *", "effect": "ask" },
    { "action": "shell", "resource": "gh *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl *", "effect": "ask" },
    { "action": "shell", "resource": "pyinfra *", "effect": "ask" },
    { "action": "shell", "resource": "uv run pyinfra *", "effect": "ask" },
    { "action": "shell", "resource": "pulumi *", "effect": "ask" },
    { "action": "shell", "resource": "helm *", "effect": "ask" },
    { "action": "shell", "resource": "scp *", "effect": "ask" },
    { "action": "shell", "resource": "ssh *", "effect": "ask" },
    { "action": "shell", "resource": "aws *", "effect": "ask" },
    { "action": "shell", "resource": "aws sts get-caller-identity*", "effect": "allow" },
    { "action": "shell", "resource": "aws account get*", "effect": "allow" },
    { "action": "shell", "resource": "aws account list*", "effect": "allow" },
    { "action": "shell", "resource": "aws apigateway get*", "effect": "allow" },
    { "action": "shell", "resource": "aws apigatewayv2 get*", "effect": "allow" },
    { "action": "shell", "resource": "aws autoscaling describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudformation describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudformation list*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudformation get-template*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudfront describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudfront get*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudfront list*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudtrail describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudtrail get*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudtrail list*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudwatch describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudwatch get*", "effect": "allow" },
    { "action": "shell", "resource": "aws cloudwatch list*", "effect": "allow" },
    { "action": "shell", "resource": "aws dynamodb describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws dynamodb list*", "effect": "allow" },
    { "action": "shell", "resource": "aws ec2 describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws ecr describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws ecr get-authorization-token*", "effect": "ask" },
    { "action": "shell", "resource": "aws ecr list*", "effect": "allow" },
    { "action": "shell", "resource": "aws ecs describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws ecs list*", "effect": "allow" },
    { "action": "shell", "resource": "aws eks describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws eks list*", "effect": "allow" },
    { "action": "shell", "resource": "aws elasticache describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws elasticache list*", "effect": "allow" },
    { "action": "shell", "resource": "aws elasticloadbalancing describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws events describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws events list*", "effect": "allow" },
    { "action": "shell", "resource": "aws iam get*", "effect": "allow" },
    { "action": "shell", "resource": "aws iam list*", "effect": "allow" },
    { "action": "shell", "resource": "aws kms describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws kms get*", "effect": "allow" },
    { "action": "shell", "resource": "aws kms list*", "effect": "allow" },
    { "action": "shell", "resource": "aws lambda get*", "effect": "allow" },
    { "action": "shell", "resource": "aws lambda list*", "effect": "allow" },
    { "action": "shell", "resource": "aws logs describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws logs filter-log-events*", "effect": "allow" },
    { "action": "shell", "resource": "aws logs get*", "effect": "allow" },
    { "action": "shell", "resource": "aws logs list*", "effect": "allow" },
    { "action": "shell", "resource": "aws organizations describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws organizations list*", "effect": "allow" },
    { "action": "shell", "resource": "aws rds describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws rds list*", "effect": "allow" },
    { "action": "shell", "resource": "aws route53 get*", "effect": "allow" },
    { "action": "shell", "resource": "aws route53 list*", "effect": "allow" },
    { "action": "shell", "resource": "aws s3 ls*", "effect": "allow" },
    { "action": "shell", "resource": "aws s3api get-bucket*", "effect": "allow" },
    { "action": "shell", "resource": "aws s3api get-public-access-block*", "effect": "allow" },
    { "action": "shell", "resource": "aws s3api head-bucket*", "effect": "allow" },
    { "action": "shell", "resource": "aws s3api head-object*", "effect": "allow" },
    { "action": "shell", "resource": "aws s3api list*", "effect": "allow" },
    { "action": "shell", "resource": "aws sns get*", "effect": "allow" },
    { "action": "shell", "resource": "aws sns list*", "effect": "allow" },
    { "action": "shell", "resource": "aws sqs get*", "effect": "allow" },
    { "action": "shell", "resource": "aws sqs list*", "effect": "allow" },
    { "action": "shell", "resource": "aws ssm describe*", "effect": "allow" },
    { "action": "shell", "resource": "aws ssm get*", "effect": "allow" },
    { "action": "shell", "resource": "aws ssm list*", "effect": "allow" },
    { "action": "shell", "resource": "aws ssm get-parameter*", "effect": "ask" },
    { "action": "shell", "resource": "aws ssm get-parameters*", "effect": "ask" },
    { "action": "shell", "resource": "az *", "effect": "ask" },
    { "action": "shell", "resource": "gcp *", "effect": "ask" },
    { "action": "shell", "resource": "git commit*--amend*", "effect": "ask" },
    { "action": "shell", "resource": "git commit*--no-verify*", "effect": "ask" },
    { "action": "shell", "resource": "git rebase*", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git stash*", "effect": "ask" },
    { "action": "shell", "resource": "git -C* commit*--amend*", "effect": "ask" },
    { "action": "shell", "resource": "git -C* commit*--no-verify*", "effect": "ask" },
    { "action": "shell", "resource": "git -C* rebase*", "effect": "ask" },
    { "action": "shell", "resource": "git -C* push*", "effect": "ask" },
    { "action": "shell", "resource": "git -C* stash*", "effect": "ask" },
    { "action": "shell", "resource": "gh pull*", "effect": "allow" },
    { "action": "shell", "resource": "gh push*", "effect": "allow" },
    { "action": "shell", "resource": "gh push*-f", "effect": "ask" },
    { "action": "shell", "resource": "gh push*--force", "effect": "ask" },
    { "action": "shell", "resource": "gh pr list*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view*", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view*", "effect": "allow" },
    { "action": "shell", "resource": "gh repo list*", "effect": "allow" },
    { "action": "shell", "resource": "gh release list*", "effect": "allow" },
    { "action": "shell", "resource": "gh release view*", "effect": "allow" },
    { "action": "shell", "resource": "gh run list*", "effect": "allow" },
    { "action": "shell", "resource": "gh run view*", "effect": "allow" },
    { "action": "shell", "resource": "gh run watch*", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow list*", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow view*", "effect": "allow" },
    { "action": "shell", "resource": "gh auth status*", "effect": "allow" },
    { "action": "shell", "resource": "kubectl get *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl describe *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl logs *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl top *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl api-resources *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl explain *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl version *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl cluster-info *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl wait *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl diff *", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" }
  ],
  "policies": [
    { "action": "provider.use", "resource": "opencode", "effect": "deny" },
    { "action": "provider.use", "resource": "amazon-bedrock", "effect": "deny" }
  ],
  "update": "disable",
  "providers": {
    "claude": {
      "name": "Claude",
      "models": {
        "opus-4.6": {
          "name": "Claude Opus 4.6",
          "modelID": "claude/claude-opus-4-6",
          "capabilities": {
            "input": [
