    "homelab": {
      "name": "Homelab",
      "models": {
        "dreamer": {
          "name": "Dreamer",
          "modelID": "dreamer",
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"],
            "tools": true,
            "reasoning": {
              "supported": true
            }
          }
        },
        "workhorse": {
          "name": "Workhorse",
          "modelID": "workhorse",
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"],
            "tools": true,
            "reasoning": {
              "supported": true
            }
          }
        },
        "turbo": {
          "name": "Turbo",
          "modelID": "turbo",
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"],
            "tools": true,
            "reasoning": {
              "supported": true
            }
          }
        },
        "gemma-4-e2b": {
          "name": "Gemma 4 E2B",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "temperature": true
          }
        },
        "local-small": {
          "name": "Local Small",
          "body": {
            "chat_template_kwargs": { "enable_thinking": false }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "variants": [
            {
              "id": "thinking",
              "body": {
                "chat_template_kwargs": { "enable_thinking": true }
              }
            },
            {
              "id": "thinking-1024",
              "body": {
                "chat_template_kwargs": { "enable_thinking": true },
                "reasoning_budget_tokens": 1024
              }
            }
          ],
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "tools": true,
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          }
        },
        "local-fast": {
          "name": "Local Fast",
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "tools": true,
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          }
        },
        "gpt-oss-120b": {
          "name": "GPT-OSS-120B",
          "headers": {
            "x-model-name": "gpt-oss-120b"
          },
          "capabilities": {
            "reasoning": {
              "supported": true
            }
          }
        }
      },
      "package": "@opencode/ai/providers/openai",
      "settings": {
        "apiKey": "unused",
        "baseURL": "https://agent-gateway.holdenitdown.net/v1"
      }
    }
  },
  "plugins": [
    "@tarquinen/opencode-dcp@3.2.0",
    "opencode-vault@git+ssh://git@git.holdenitdown.net/rfhold/opencode-vault.git#opencode/v0.1.2"
  ]
