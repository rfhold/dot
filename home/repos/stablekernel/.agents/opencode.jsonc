{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        "profile": "stablekernel-shrine"
      }
    },
    "bifrost": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bifrost",
      "options": {
        "baseURL": "https://gateway.skysquid.net/openai"
      },
      "models": {
        "bedrock/qwen.qwen3-coder-next": { "name": "Qwen3 Coder Next" },
        "bedrock/qwen.qwen3-coder-30b-a3b-v1:0": { "name": "Qwen3 Coder 30B" },
        "bedrock/qwen.qwen3-32b-v1:0": { "name": "Qwen3 32B" },
        "bedrock/mistral.devstral-2-123b": { "name": "Devstral 2 123B" },
        "bedrock/mistral.mistral-large-3-675b-instruct": { "name": "Mistral Large 3" },
        "bedrock/deepseek.v3.2": { "name": "DeepSeek V3.2" },
        "bedrock/moonshotai.kimi-k2.5": { "name": "Kimi K2.5" },
        "bedrock/moonshot.kimi-k2-thinking": { "name": "Kimi K2 Thinking" },
        "bedrock/minimax.minimax-m2.5": { "name": "MiniMax M2.5" },
        "bedrock/zai.glm-5": { "name": "GLM-5" },
        "bedrock/zai.glm-4.7": { "name": "GLM-4.7" },
        "bedrock/nvidia.nemotron-super-3-120b": { "name": "Nemotron Super 3 120B" },
        "bedrock/google.gemma-3-27b-it": { "name": "Gemma 3 27B" },
        "bedrock/openai.gpt-oss-120b-1:0": { "name": "GPT-OSS 120B" },
        "bedrock/openai.gpt-5.6-luna": { "name": "GPT-5.6 Luna" },
        "bedrock/openai.gpt-5.6-sol": { "name": "GPT-5.6 Sol" },
        "bedrock/openai.gpt-5.6-terra": { "name": "GPT-5.6 Terra" },
        "bedrock/amazon.nova-pro-v1:0": { "name": "Amazon Nova Pro" },
        "squid-pool/qwen3.8-27b": { "name": "Qwen 3.8 27B (Squid Pool)" },
        "anthropic/claude-opus-4-5": { "name": "Claude Opus 4.5" },
        "anthropic/claude-opus-4-6": { "name": "Claude Opus 4.6" },
        "anthropic/claude-opus-4-7": { "name": "Claude Opus 4.7" },
        "anthropic/claude-opus-4-8": { "name": "Claude Opus 4.8" },
        "anthropic/claude-opus-5": { "name": "Claude Opus 5" },
        "anthropic/claude-sonnet-4-6": { "name": "Claude Sonnet 4.6" },
        "anthropic/claude-sonnet-5": { "name": "Claude Sonnet 5" },
        "anthropic/claude-haiku-4-5": { "name": "Claude Haiku 4.5" }
      }
    }
  }
}
